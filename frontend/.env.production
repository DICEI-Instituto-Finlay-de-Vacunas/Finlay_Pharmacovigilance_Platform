# Public, non-secret settings used by `vite build` for the Cloudflare deployment.
# Any of these can be overridden with a build variable (Cloudflare dashboard / GitHub Actions).
#
# NOTE: the URL must end in /api. If Render assigns a different service URL, change it here
# or set VITE_API_BASE_URL as a build variable.
VITE_API_BASE_URL=https://finlay-pharmacovigilance-api.onrender.com/api
# Free hosts sleep when idle and need up to ~1 minute to wake up on the first request.
VITE_API_TIMEOUT=60000
